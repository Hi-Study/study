{
  "expo": {
    "name": "distill",
    "slug": "study-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "studyapp",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.studyapp"
    },
    "android": {
      "package": "com.example.studyapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "distill",
      "shortName": "distill",
      "lang": "ko",
      "themeColor": "#4F46E5",
      "backgroundColor": "#F9FAFB",
      "display": "standalone"
    },
    "plugins": [
      "expo-font",
      "expo-notifications",
      "expo-web-browser"
    ],
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "eas": {
        "projectId": "6e1002ff-65bb-4135-9e5e-8113c759dacc"
      }
    }
  }
}
