# 이 파일을 .env.local 로 복사하고 값을 넣으세요. .env.local 은 GitHub 에 올라가지 않습니다.

# Supabase — 대시보드 Project Settings → API (필수, 글 데이터가 여기 있습니다)
SUPABASE_URL=
# service_role 키는 DB 전체 권한입니다. 서버 환경변수로만 쓰고 공유하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Gemini — 이 프로젝트 전용 키. 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 선택: 기본값 gemini-flash-lite-latest
# GEMINI_MODEL=gemini-flash-lite-latest

# 자동 수집(/api/cron/*)을 부를 때 쓰는 비밀값 — supabase/cron.sql 에 넣는 값과 같아야 합니다
CRON_SECRET=
